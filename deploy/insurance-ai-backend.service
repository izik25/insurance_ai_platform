[Unit]
Description=Insurance AI Platform - FastAPI backend
After=network.target postgresql.service

[Service]
Type=simple
User=insuranceai
Group=insuranceai
WorkingDirectory=/opt/insurance_ai_platform
EnvironmentFile=/opt/insurance_ai_platform/.env
ExecStart=/opt/insurance_ai_platform/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
