APP_NAME="Insurance AI Platform"
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

DATA_DIR=./data
STORAGE_BACKEND=local

DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5432/insurance_ai_platform
TESSDATA_DIR=./tessdata
OCR_LANGUAGE=heb

# Required for scripts/extract_documents.py (structured field extraction via Claude)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
SIMILARITY_AUTO_CONFIRM_THRESHOLD=0.95
