APP_NAME="Insurance AI Platform"
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

DATA_DIR=./data
STORAGE_BACKEND=local

DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5432/insurance_ai_platform
TESSDATA_DIR=./tessdata
OCR_LANGUAGE=heb

# Required for scripts/extract_documents.py (structured field extraction via OpenAI)
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
SIMILARITY_AUTO_CONFIRM_THRESHOLD=0.95

# Unused currently (extraction runs on OpenAI - see above) - kept in case
# Anthropic access is restored later.
ANTHROPIC_API_KEY=
